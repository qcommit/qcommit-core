{
  "name": "@qcommit/core",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Qcommit launch-authorization protocol, encrypted creator identities, and independent verification.",
  "engines": {
    "node": ">=22.16.0"
  },
  "exports": {
    ".": "./src/protocol.mjs",
    "./vault": "./src/vault.mjs",
    "./verify": "./src/slh-verify.mjs",
    "./launch": "./sdk/index.mjs",
    "./launch/approval": "./sdk/approval.mjs",
    "./launch/operator": "./sdk/operator.mjs",
    "./launch/deployer": "./sdk/deployer.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:signing": "node tests/signing.integration.mjs",
    "test:mutations": "python3 tests/native_mutations.py",
    "test:vectors": "node tests/nist.mjs",
    "test:sdk": "node --test sdk/test/*.test.mjs",
    "test:onchain": "bash scripts/test-onchain.sh"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "@solana/web3.js": "1.98.4",
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
